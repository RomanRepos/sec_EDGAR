cells:
  - kind: 2
    languageId: sql
    value: "select companyDimension.cik AS descriptions\r

      from raw_data \r

      inner join companyDimension on raw_data.cik=companyDimension.cik\r

      and companyDimension.firstTicker = 'AAPL'\r

      \r

      \r

      --fy, fp, end, accn, val\r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "CREATE OR REPLACE TEMP TABLE topLevelKeysAvailable AS \r

      select \r

      cik,\r

      key\r

      \r

      from raw_data, json_each(json_col->'$.nested_metadata') AS entry;\r

      where cik = 2969 and cik is not null and topLevelKeys != []\r

      ;\r

      \r

      \r

      \r

      SET threads = 3;\r

      SET preserve_insertion_order = false;\r

      CREATE OR REPLACE TEMP TABLE finMeasuresKeysAvailable AS \r

      select \r

      tlka.cik,\r

      tlka.source,\r

      json_keys(facts) AS finMsrKeys\r

      \r

      from topLevelKeysAvailable as tlka;\r

      \r

      \r

      /*\r

      SET preserve_insertion_order = false;\r

      CREATE OR REPLACE TEMP TABLE finMeasuresWithUnitsAvailable AS \r

      select \r

      fmka.cik,\r

      fmka.source,\r

      fmka.finMsrKey\r

      \r

      \r

      from finMeasuresKeysAvailable fmka;\r

      \r

      */\r

      \r

      \r\n"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "select \r

      cik,\r

      unnest(json_keys(facts))\r

      \r

      from raw_data\r

      where cik = 2969\r

      ;"
    metadata: {}
  - kind: 2
    languageId: sql
    value: "select \r

      cik,\r

      unnest(json_keys(json_transform(facts,
      '{\"dei\":\"VARCHAR\",\"srt\":\"VARCHAR\",\"us-gaap\":\"VARCHAR\",\"invest\
      \":\"VARCHAR\",\"ifrs-full\":\"VARCHAR\"}')))\r

      \r

      from raw_data\r

      --where cik = 2969"
    metadata: {}
  - kind: 2
    languageId: sql
    value: ""
    metadata: {}
