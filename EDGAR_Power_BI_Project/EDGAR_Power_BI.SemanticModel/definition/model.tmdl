model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["standardMetrics","companyDimension","dailyStockPrices","driverName","databasePath","measuresTable"]

annotation PBI_ProTooling = ["DevMode"]

ref table companyDimension
ref table standardMetrics
ref table dailyStockPrices
ref table Date
ref table measuresTable

ref cultureInfo en-US

